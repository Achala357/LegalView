
# LegalView backend configuration
# Copy this file to .env and provide your own credentials.

# Required for OpenAI-powered question answering.
# Leave unset if you only want to start the API
# without using LLM-generated responses.
OPENAI_API_KEY=

# Embedding model for uploaded-contract retrieval
UPLOAD_EMBED_MODEL=intfloat/e5-base-v2

# Directory for generated upload-specific FAISS indexes
UPLOAD_FAISS_DIR=indexes/uploads
